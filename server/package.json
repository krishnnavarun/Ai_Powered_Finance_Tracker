{
  "name": "paisa-pal-server",
  "version": "0.1.0",
  "private": true,
  "description": "Paisa Pal API — Node.js + Express",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "e2e:server": "node scripts/e2e-server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  }
}
