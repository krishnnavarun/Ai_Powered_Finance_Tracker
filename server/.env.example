NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=

# Database (required). Pick one:
#   MongoDB Atlas (free):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/paisa-pal
#   Docker (npm run db:up): mongodb://localhost:27017/paisa-pal?directConnection=true
# Must be a replica set (Atlas and the docker-compose setup both are) — needed for transactions.
MONGODB_URI=mongodb://localhost:27017/paisa-pal?directConnection=true

# Redis (optional — leave empty to run without cache/queues). Pick one:
#   Upstash (free):        rediss://default:<token>@<name>.upstash.io:6379
#   Docker (npm run db:up): redis://localhost:6379
REDIS_URL=

# Auth (use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AI
LLM_PROVIDER=gemini            # gemini | openai | groq | ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_FAST=
LLM_MODEL_SMART=

# File storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
