NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Proxies in front of the API in production: 1 = Render only, 2 = Vercel /api rewrite + Render.
TRUST_PROXY_HOPS=1
# fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
LOG_LEVEL=

# Database (required). Pick one:
#   MongoDB Atlas (free):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/paisa-pal
#   Docker (npm run db:up): mongodb://localhost:27017/paisa-pal?directConnection=true
# Must be a replica set (Atlas and the docker-compose setup both are) — needed for transactions.
MONGODB_URI=mongodb://localhost:27017/paisa-pal?directConnection=true

# Redis (optional — leave empty to run without cache/queues). Pick one:
#   Upstash (free):        rediss://default:<token>@<name>.upstash.io:6379
#   Docker (npm run db:up): redis://localhost:6379
REDIS_URL=

# Background jobs (recurring payments, budget alerts, nightly insights).
# false = run `npm run worker` as a second process; true = run them inside the API
# (for hosting without background workers, e.g. Render's free plan).
JOBS_IN_API=false

# Auth (required). Two DIFFERENT random strings, 32+ characters each. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional (defaults shown)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# AI (optional — without a key the app works as a normal tracker)
# Gemini has a free tier: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini            # gemini | openai | groq | ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty for the provider's default models.
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_TIMEOUT_MS=15000

# Receipt photos
#   local      → saved in UPLOAD_DIR on this machine (good for development)
#   cloudinary → saved privately on Cloudinary (use this when deployed: hosting disks
#                are wiped on restart). Free account: https://cloudinary.com → Dashboard.
RECEIPT_STORAGE=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email for the weekly digest (optional — without it the digest is only shown in the app).
# Free plan at https://resend.com. EMAIL_FROM must use a domain you verified there, e.g.
#   EMAIL_FROM=Paisa Pal <digest@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
