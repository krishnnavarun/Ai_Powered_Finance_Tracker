NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database / cache
MONGODB_URI=mongodb://localhost:27017/paisa-pal
REDIS_URL=redis://localhost:6379

# Auth (use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AI
LLM_PROVIDER=gemini            # gemini | openai | groq | ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_FAST=
LLM_MODEL_SMART=

# File storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
